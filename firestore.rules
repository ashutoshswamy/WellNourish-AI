rules_version = '2';

// All reads/writes go through the server (Admin SDK, which bypasses these
// rules) via API routes and Server Components — the client never talks to
// Firestore directly. Deny everything else by default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
